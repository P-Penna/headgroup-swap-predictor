# Copy to .env at the repository root and edit, or just export these in your
# shell. Every one has a working default, so the interface runs with no .env
# at all. Nothing here is a secret; the interface makes no network calls and
# needs no API keys.

# WHICH FOLD'S FIVE SEEDS THE INTERFACE LOADS (0-4, default 0).
#
# There is no model trained on all the data. Each checkpoint was trained on
# four of the five molecule-disjoint folds so the fifth could score it
# honestly. The interface has to pick one set of five seeds, and this chooses
# which. Molecules in the chosen fold are genuinely unseen by those models;
# molecules in the other four were in their training data.
#
# Change it if you want a second opinion on a prediction: run fold 0 and fold
# 3 and see whether they agree. They are different models, not the same model
# twice.
HEADGROUP_FOLD=0

# Gradio server settings, read by gradio itself rather than by this code.
# Uncomment to serve on a specific host or port, or to get a public share link.
# GRADIO_SERVER_NAME=0.0.0.0
# GRADIO_SERVER_PORT=7860
# GRADIO_SHARE=False
